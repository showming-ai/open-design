{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-design.ai/schemas/dsh-stdio/1/baseline.json",
  "title": "OpenDesign × DeepSeek Harness stdio protocol v1",
  "description": "One JSON object per line over stdin (host->child) and stdout (child->host) of `dsh --profile open-design {--probe|--models|--stdio}`. Wire version is 1. Unknown fields are tolerated and dropped by the child; hosts must ignore unknown frame types for forward compatibility. Owner: @open-design/dsh-runtime. See protocol.md.",
  "type": "object",
  "required": ["v", "type"],
  "properties": {
    "v": { "const": 1, "description": "Wire protocol version." },
    "type": { "type": "string" }
  },
  "allOf": [
    {
      "$comment": "Host->child commands (stdin).",
      "if": { "properties": { "type": { "enum": ["execute", "cancel"] } }, "required": ["type"] },
      "then": { "oneOf": [
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "execute" },
            "request_id": { "type": "string", "minLength": 1 },
            "cwd": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string", "minLength": 1 },
            "mcp_servers": { "type": "array" },
            "resume_session_id": { "type": "string", "minLength": 1 },
            "model": {
              "type": "object",
              "properties": {
                "provider": { "type": "string", "minLength": 1 },
                "id": { "type": "string", "minLength": 1 }
              },
              "required": ["provider", "id"]
            },
            "reasoning_effort": { "type": "string", "minLength": 1 }
          },
          "required": ["v", "type", "request_id", "cwd", "prompt", "mcp_servers"]
        },
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "cancel" },
            "request_id": { "type": "string", "minLength": 1 }
          },
          "required": ["v", "type", "request_id"]
        }
      ] }
    },
    {
      "$comment": "Child->host identity and catalog frames (stdout).",
      "if": { "properties": { "type": { "enum": ["probe", "ready", "models"] } }, "required": ["type"] },
      "then": { "oneOf": [
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "enum": ["probe", "ready"] },
            "runtime": { "const": "open-design" },
            "protocol_version": { "const": 1 },
            "plugin_version": { "type": "string", "minLength": 1 },
            "capabilities": {
              "type": "object",
              "properties": {
                "session_resume": { "type": "boolean" },
                "session_cancel": { "type": "boolean" },
                "structured_events": { "type": "boolean" }
              },
              "additionalProperties": { "type": "boolean" }
            }
          },
          "required": ["v", "type", "runtime", "protocol_version", "plugin_version", "capabilities"]
        },
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "models" },
            "runtime": { "const": "open-design" },
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider": { "type": "string" },
                  "provider_name": { "type": "string" },
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "reasoning_options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "default": { "type": "boolean" }
                      },
                      "required": ["id", "name"]
                    }
                  }
                },
                "required": ["provider", "provider_name", "id", "name"]
              }
            }
          },
          "required": ["v", "type", "runtime", "models"]
        }
      ] }
    },
    {
      "$comment": "Child->host run frames (stdout).",
      "if": { "properties": { "type": { "enum": ["session", "text", "thinking", "tool_call", "tool_result", "usage", "result", "protocol_error"] } }, "required": ["type"] },
      "then": { "oneOf": [
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "session" },
            "request_id": { "type": "string", "minLength": 1 },
            "session_id": { "type": "string", "minLength": 1 },
            "resumed": { "type": "boolean" }
          },
          "required": ["v", "type", "request_id", "session_id", "resumed"]
        },
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "enum": ["text", "thinking"] },
            "request_id": { "type": "string", "minLength": 1 },
            "content": { "type": "string" }
          },
          "required": ["v", "type", "request_id", "content"]
        },
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "tool_call" },
            "request_id": { "type": "string", "minLength": 1 },
            "call_id": { "type": "string" },
            "name": { "type": "string" },
            "arguments": { "type": "object" }
          },
          "required": ["v", "type", "request_id", "call_id", "name", "arguments"]
        },
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "tool_result" },
            "request_id": { "type": "string", "minLength": 1 },
            "call_id": { "type": "string" },
            "name": { "type": "string" },
            "output": { "type": "string" },
            "is_error": { "type": "boolean" }
          },
          "required": ["v", "type", "request_id", "call_id", "name", "output", "is_error"]
        },
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "usage" },
            "request_id": { "type": "string", "minLength": 1 },
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "input_tokens": { "type": "integer" },
            "output_tokens": { "type": "integer" },
            "cache_read_tokens": { "type": "integer" },
            "cache_write_tokens": { "type": "integer" }
          },
          "required": ["v", "type", "request_id", "provider", "model", "input_tokens", "output_tokens"]
        },
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "result" },
            "request_id": { "type": "string", "minLength": 1 },
            "session_id": { "type": "string", "minLength": 1 },
            "status": { "enum": ["completed", "cancelled", "failed"] },
            "output": { "type": "string" },
            "stop_reason": { "type": "string" },
            "resume_rejected": { "type": "boolean" },
            "error": {
              "type": "object",
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 }
              },
              "required": ["code", "message"]
            }
          },
          "required": ["v", "type", "request_id", "session_id", "status", "resume_rejected"]
        },
        {
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "protocol_error" },
            "request_id": { "type": "string", "minLength": 1 },
            "code": { "enum": ["DSH_PROFILE_INVALID_COMMAND", "DSH_PROFILE_BUSY"] },
            "message": { "type": "string", "minLength": 1 }
          },
          "required": ["v", "type", "code", "message"]
        }
      ] }
    }
  ],
  "additionalProperties": true
}
